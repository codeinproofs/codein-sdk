{
  "name": "@codein/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for the CodeIn launch API — preview, create, and stream app builds",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "codein",
    "solana",
    "pump.fun",
    "ai",
    "sdk",
    "typescript"
  ],
  "author": "CodeIn",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codeinproofs/codein-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/codeinproofs/codein-sdk/issues"
  },
  "homepage": "https://github.com/codeinproofs/codein-sdk#readme",
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
